# Microsoft Fabric SQL Analytics Endpoint for dbt-fabric
FABRIC_SERVER=your-workspace-guid.datawarehouse.fabric.microsoft.com

# Target Fabric Warehouse cho tầng Gold (Warehouse hỗ trợ đầy đủ quyền tạo bảng T-SQL)
FABRIC_DATABASE=wh_gold
FABRIC_SCHEMA=dbo

# Source Lakehouse for Silver Layer (Cross-Lakehouse Query)
FABRIC_SILVER_DATABASE=your_silver_lakehouse_name
FABRIC_SILVER_SCHEMA=dbo

# Fabric Authentication (Azure Service Principal / Entra ID)
FABRIC_TENANT_ID=your_azure_tenant_id
FABRIC_CLIENT_ID=your_service_principal_client_id
FABRIC_CLIENT_SECRET=your_service_principal_client_secret

# Fabric Workspace & Item IDs (For Airflow MSFabricRunJobOperator)
FABRIC_WORKSPACE_ID=your_fabric_workspace_id
FABRIC_BRONZE_SPARK_JOB_ID=your_bronze_spark_job_definition_id
FABRIC_SILVER_SPARK_JOB_ID=your_silver_spark_job_definition_id
