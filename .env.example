# Microsoft Fabric SQL Analytics Endpoint for dbt-fabric
FABRIC_SERVER=your-server.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=your_lakehouse_name

# Fabric Authentication (Service Principal)
FABRIC_TENANT_ID=your_tenant_id
FABRIC_CLIENT_ID=your_client_id
FABRIC_CLIENT_SECRET=your_client_secret

# Fabric Workspace & Item IDs (For Airflow MSFabricRunJobOperator)
FABRIC_WORKSPACE_ID=your_workspace_id
FABRIC_BRONZE_SPARK_JOB_ID=your_bronze_job_id
FABRIC_SILVER_SPARK_JOB_ID=your_silver_job_id
